{
  "name": "squishybot",
  "version": "0.8.9",
  "description": "SquishyBot Discord bot",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "deploy:commands": "node dist/bot/registerCommands.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "typecheck": "node --max-old-space-size=384 node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.20.1"
    }
  }
}
